+DmResult DmPerformance_getPlayback(DmPerformance* slf, DmPlayback* out) {
+	if (slf == NULL || out == NULL) {
+		return DmResult_INVALID_ARGUMENT;
+	}
+
+	if (mtx_lock(&slf->lock) != thrd_success) {
+		return DmResult_MUTEX_ERROR;
+	}
+
+	out->serial = slf->segment_serial;
+	out->playing = slf->segment != NULL;
+	out->remaining = 0;
+
+	if (slf->segment != NULL) {
+		uint32_t end = slf->segment_start + slf->segment->length;
+		if (end > slf->time) {
+			out->remaining =
+			    Dm_getSampleCountForDuration(end - slf->time, slf->time_signature, slf->tempo, slf->sample_rate, 1);
+		}
+	}
+
+	(void) mtx_unlock(&slf->lock);
+	return DmResult_SUCCESS;
+}
