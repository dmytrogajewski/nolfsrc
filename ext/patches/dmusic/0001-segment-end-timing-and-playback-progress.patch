+	/// \brief Timing flag indicating start once the playing segment ends, replacing its pending repeats.
+	DmTiming_SEGMENT = 5,
 } DmTiming;
 
+/// \brief The playing segment's progress, sampled between render calls.
+typedef struct DmPlayback {
+	/// \brief Changes whenever a segment starts, repeats or playback stops.
+	uint32_t serial;
+
+	/// \brief Sample frames until the playing segment ends at the current tempo, zero once it has.
+	size_t remaining;
+
+	/// \brief Non-zero while a segment is playing, even after its end until another starts.
+	int playing;
+} DmPlayback;
