@@ -101,6 +101,17 @@ static uint32_t Dm_getBoundaryOffset(DmPerformance* slf, DmTiming timing) {
 	case DmTiming_MEASURE:
 		timing_unit_length = Dm_getMeasureLength(slf->time_signature);
 		break;
+	case DmTiming_SEGMENT: {
+		if (slf->segment == NULL) {
+			return slf->time;
+		}
+
+		// A segment message at the same time replaces the pending repeat.
+		uint32_t end = slf->segment_start + slf->segment->length;
+		return end > slf->time ? end : slf->time;
+	}
+	default:
+		return slf->time;
 	}
 
