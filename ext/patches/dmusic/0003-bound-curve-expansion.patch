+// Curves are sampled at most this many times. Authored durations can be huge;
+// an instant curve only sets its end value.
+#define DmInt_CURVE_MAX_STEPS 4096U
+
+static uint32_t DmCurve_getSteps(DmCurve const* curve, uint32_t* spacing) {
+	*spacing = DmInt_CURVE_SPACING;
+	if (curve->curve_shape == DmCurveShape_INSTANT) {
+		return 1;
+	}
+
+	uint32_t steps = curve->duration / DmInt_CURVE_SPACING;
+	if (steps > DmInt_CURVE_MAX_STEPS) {
+		*spacing = curve->duration / DmInt_CURVE_MAX_STEPS;
+		steps = DmInt_CURVE_MAX_STEPS;
+	}
+
+	return steps;
+}
