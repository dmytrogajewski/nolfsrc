diff --git a/src/Performance.c b/src/Performance.c
index e5c59cd..8ca920e 100644
--- a/src/Performance.c
+++ b/src/Performance.c
@@ -740,6 +740,7 @@ static void DmPerformance_handleSegmentMessage(DmPerformance* slf, DmMessage_Seg
 		DmBand_release(slf->band);
 
 		slf->time = 0;
+		slf->time_fraction = 0;
 		slf->style = NULL;
 		slf->segment = NULL;
 		slf->band = NULL;
@@ -754,6 +755,7 @@ static void DmPerformance_handleSegmentMessage(DmPerformance* slf, DmMessage_Seg
 
 	// Reset the time to combat drift
 	slf->time = 0;
+	slf->time_fraction = 0;
 
 	// Import all the new segment's messages
 	// NOTE: If we have a different `play_start` or `loop_start`, we need to discard messages
@@ -985,6 +987,7 @@ DmResult DmPerformance_renderPcm(DmPerformance* slf, void* buf, size_t len, DmRe
 
 		sample += offset_samples;
 		slf->time += time_offset;
+		slf->time_fraction = 0;
 
 		// Handle the next message
 		if (ok_ctrl) {
@@ -1002,8 +1005,13 @@ DmResult DmPerformance_renderPcm(DmPerformance* slf, void* buf, size_t len, DmRe
 	// Render the remaining samples
 	uint32_t remaining_samples = (uint32_t) (len - sample);
 	(void) DmSynth_render(&slf->synth, buf, remaining_samples, opts);
-	slf->time +=
-	    Dm_getDurationForSampleCount(remaining_samples, slf->time_signature, slf->tempo, slf->sample_rate, channels);
+
+	// Rounding each call's duration to whole ticks would make the tempo depend on the render size.
+	double ticks = Dm_getTicksPerSample(slf->time_signature, slf->tempo, slf->sample_rate) / channels * remaining_samples
+	    + slf->time_fraction;
+	uint32_t whole_ticks = (uint32_t) ticks;
+	slf->time_fraction = ticks - whole_ticks;
+	slf->time += whole_ticks;
 
 	return DmResult_SUCCESS;
 }
