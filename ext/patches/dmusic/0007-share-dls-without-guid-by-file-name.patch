+// Collections without a GUID (DLS files lacking a 'dlid' chunk) are shared by
+// file name instead; an all-zero GUID must not match every other one.
+static bool DmLoader_isNullGuid(DmGuid const* guid) {
+	for (size_t i = 0; i < sizeof guid->data; ++i) {
+		if (guid->data[i] != 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+static bool DmLoader_isSameFile(char const* a, char const* b) {
+	if (a == NULL || b == NULL) {
+		return false;
+	}
+	for (; *a != '\0' && *b != '\0'; ++a, ++b) {
+		if (tolower((unsigned char) *a) != tolower((unsigned char) *b)) {
+			return false;
+		}
+	}
+	return *a == *b;
+}
+
+static bool DmLoader_isCachedDls(DmDls const* dls, DmReference const* ref) {
+	if (!DmLoader_isNullGuid(&dls->guid)) {
+		return DmGuid_equals(&ref->guid, &dls->guid);
+	}
+	return DmLoader_isSameFile(dls->file_name, ref->file);
+}
