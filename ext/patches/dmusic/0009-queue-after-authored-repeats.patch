 			return slf->time;
 		}
 
-		// A segment message at the same time replaces the pending repeat.
-		uint32_t end = slf->segment_start + slf->segment->length;
+		// After the last repeat; repeats keep it scheduled (see DmPerformance_handleSegmentMessage).
+		uint32_t end = Dm_getSegmentEnd(slf);
 		return end > slf->time ? end : slf->time;
 	}
 	default:
