-	DmSegment_release(slf->segment);
+	if (slf->segment != NULL) {
+		DmSegment_release(slf->segment);
+	}
 	slf->segment_serial += 1;
 
+	// A repeat keeps segment changes scheduled after it, rebased onto its restarted clock.
+	enum { DmInt_KEPT_SEGMENT_CHANGES = 8 };
+	DmMessage kept[DmInt_KEPT_SEGMENT_CHANGES];
+	size_t kept_count = 0;
+	if (sgt != NULL && msg->loop != 0) {
+		for (size_t i = 0; i < slf->control_queue.queue_length && kept_count < DmInt_KEPT_SEGMENT_CHANGES; ++i) {
+			DmMessage* pending = &slf->control_queue.queue[i]->data;
+			if (pending->type == DmMessage_SEGMENT && pending->time >= slf->time) {
+				DmMessage_copy(pending, &kept[kept_count++], (int64_t) pending->time - (int64_t) slf->time);
+			}
+		}
+	}
+
 	// Get rid of the currently playing segment.
 	DmMessageQueue_clear(&slf->control_queue);
 	DmMessageQueue_clear(&slf->music_queue);
