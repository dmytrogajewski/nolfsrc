+// Every repeat restarts the clock and lasts the segment's length.
+static uint32_t Dm_getSegmentEnd(DmPerformance const* slf) {
+	uint32_t remaining = slf->segment->repeats > slf->segment_loop ? slf->segment->repeats - slf->segment_loop : 0;
+	return slf->segment_start + slf->segment->length * (remaining + 1);
+}
