 	slf->segment = DmSegment_retain(sgt);
 	slf->segment_start = slf->time;
+	slf->segment_loop = msg->loop;
+
+	for (size_t i = 0; i < kept_count; ++i) {
+		DmMessageQueue_add(&slf->control_queue, &kept[i], kept[i].time, DmQueueConflict_REPLACE);
+		DmMessage_free(&kept[i]);
+	}
 
 	// If required, schedule to loop this segment.
