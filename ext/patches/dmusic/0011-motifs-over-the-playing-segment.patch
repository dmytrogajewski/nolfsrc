+DmMotif* DmMotif_retain(DmMotif* slf) {
+	if (slf == NULL) {
+		return NULL;
+	}
+
+	(void) atomic_fetch_add(&slf->reference_count, 1);
+	return slf;
+}
+
+void DmMotif_release(DmMotif* slf) {
+	if (slf == NULL) {
+		return;
+	}
+
+	size_t refs = atomic_fetch_sub(&slf->reference_count, 1) - 1;
+	if (refs > 0) {
+		return;
+	}
+
+	DmStyle_release(slf->style);
+	Dm_free(slf);
+}
+
+static bool Dm_equalsIgnoringCase(char const* a, char const* b) {
+	for (; *a != '\0' && *b != '\0'; ++a, ++b) {
+		if (tolower((unsigned char) *a) != tolower((unsigned char) *b)) {
+			return false;
+		}
+	}
+	return *a == *b;
+}
+
+DmResult DmLoader_getMotif(DmLoader* slf, char const* style, char const* name, DmMotif** motif) {
+	if (slf == NULL || style == NULL || name == NULL || motif == NULL) {
+		return DmResult_INVALID_ARGUMENT;
+	}
+
+	DmReference ref;
+	memset(&ref, 0, sizeof ref);
+	ref.file = style;
+	ref.name = style;
+
+	DmStyle* sty = NULL;
+	DmResult rv = DmLoader_getStyle(slf, &ref, &sty);
+	if (rv != DmResult_SUCCESS) {
+		return rv;
+	}
+
+	if (slf->autodownload) {
+		rv = DmStyle_download(sty, slf);
+		if (rv != DmResult_SUCCESS) {
+			DmStyle_release(sty);
+			return rv;
+		}
+	}
+
+	// DMUS_EMBELLISHT_MOTIF
+	for (size_t i = 0; i < sty->patterns.length; ++i) {
+		DmPattern* pttn = &sty->patterns.data[i];
+		if ((pttn->embellishment & 16) == 0 || pttn->info.unam == NULL || !Dm_equalsIgnoringCase(pttn->info.unam, name)) {
+			continue;
+		}
+
+		DmMotif* new = *motif = Dm_alloc(sizeof *new);
+		if (new == NULL) {
+			DmStyle_release(sty);
+			return DmResult_MEMORY_EXHAUSTED;
+		}
+
+		new->reference_count = 1;
+		new->style = sty;
+		new->pattern = pttn;
+		return DmResult_SUCCESS;
+	}
+
+	DmStyle_release(sty);
+	return DmResult_NOT_FOUND;
+}
