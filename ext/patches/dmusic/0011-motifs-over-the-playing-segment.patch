+DmResult DmPerformance_playMotif(DmPerformance* slf, DmMotif* motif, DmTiming timing) {
+	if (slf == NULL || motif == NULL) {
+		return DmResult_INVALID_ARGUMENT;
+	}
+
+	if (mtx_lock(&slf->lock) != thrd_success) {
+		return DmResult_MUTEX_ERROR;
+	}
+
+	// A motif plays over a segment; with none playing there is nothing for it to join.
+	DmResult rv = DmResult_SUCCESS;
+	if (slf->segment != NULL) {
+		uint32_t start = Dm_getBoundaryOffset(slf, timing);
+		rv = DmPattern_generateMessages(motif->pattern, motif->style, &slf->chord, start, slf->variation, &slf->motif_queue);
+	}
+
+	(void) mtx_unlock(&slf->lock);
+	return rv;
+}
